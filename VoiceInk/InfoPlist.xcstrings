    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco benötigt Zugriff auf Ihr Mikrofon, um Audio für die Transkription aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Voco needs access to your microphone to record audio for transcription."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco 需要访问麦克风以录制音频用于转录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco 需要取用您的麥克風來錄製語音以進行轉錄。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco a besoin d'accéder à votre microphone pour enregistrer l'audio à des fins de transcription."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco benötigt Zugriff auf die Bildschirmaufnahme, um Kontext von Ihrem Bildschirm für eine höhere Transkriptionsgenauigkeit zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Voco needs screen recording access to understand context from your screen for improved transcription accuracy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco 需要屏幕录制权限以理解屏幕上的上下文，提高转录准确性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco 需要螢幕錄製權限，以理解螢幕上的內容來提升轉錄準確度。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voco a besoin d'un accès à l'enregistrement d'écran pour comprendre le contexte de votre écran afin d'améliorer la précision de la transcription."
          }
        }
      }
    }
  },
  "version" : "1.0"
