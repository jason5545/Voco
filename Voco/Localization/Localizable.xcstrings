      }
    },
    "Automatically adds corrected words to your vocabulary when you edit a transcription after pasting. This feature is experimental and may not work perfectly.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您在貼上轉錄結果後進行編輯時，會自動將修正後的詞彙新增至詞彙庫。此功能為實驗性功能，可能無法完美運作。"
          }
        }
      }
    },
    "Automatically apply custom configurations based on the app/website you are using.": {
      "localizations": {
