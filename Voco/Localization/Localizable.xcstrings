    "Vocabulary helps supported transcription models and AI enhancement preserve important names, technical terms, and unique spellings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vokabular hilft unterstützten Transkriptionsmodellen und der KI-Verbesserung, wichtige Namen, Fachbegriffe und besondere Schreibweisen beizubehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
