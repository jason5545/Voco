        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Voco 會暫時使用剪貼簿來貼上轉錄文字。啟用後，會在指定延遲後復原你原本的剪貼簿內容。停用時，貼上的轉錄文字會留在剪貼簿。"
          }
        }
      }
    },
